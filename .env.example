# database 
POSTGRES_USER=codearena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codearena
DATABASE_URL=postgresql+psycopg://codearena:change-me@db:5432/codearena

# auth
JWT_SECRET=change-me-32-min-string
DEBUG=false

# runner vars (secret must match /etc/code_arena/runner.env)
RUNNER_SECRET_KEY=change-me
RUNNER_URL=http://host.docker.internal:9500/run
RUNNER_TIMEOUT_SECONDS=30

# reverse proxy: origins allowed to call the api, and the path prefix caddy serves it under
CORS_ORIGINS=["http://localhost:3000"]
ROOT_PATH=/api