[Unit]
Description=Code arena deploy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=student
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/code_arena/deploy.env
StateDirectory=codearena-deploy
ExecStart=/usr/bin/python3 /opt/code_arena/infra/deploy/deploy.py