# copy to /etc/code_arena/runner.env (root:root, chmod 600)

# secret between the backend and the runner, letters and digits only
RUNNER_SECRET_KEY=change-me
TMPDIR=/var/lib/code_arena/runs

# the number of containers that can exist at once
RUNNER_MAX_CONCURRENT=1
# cpu utilization limit
RUNNER_CPU_CORES=1
# the number of pids the runner can create, default set to 22
RUNNER_PIDS_LIMIT=22
# default set to 26MB max size of the container's /tmp
RUNNER_TMPFS_SIZE_MB=26